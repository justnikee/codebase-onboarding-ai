# Server Configuration
PORT=5000
NODE_ENV=development

# IBM Watson Configuration
# Get these from: https://cloud.ibm.com/ (see ENV_SETUP_GUIDE.md)
IBM_WATSONX_API_KEY=your_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Use Mock Service (set to 'true' to test without real IBM credentials)
USE_MOCK_WATSONX=false

# IBM Bob Configuration (if separate)
IBM_BOB_API_KEY=your_bob_api_key_here

# GitHub API (optional - for higher rate limits)
GITHUB_TOKEN=your_github_token_here

# CORS Configuration
FRONTEND_URL=http://localhost:3000
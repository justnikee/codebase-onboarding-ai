# ============================================================
# TrendArena Bot — Environment Variables
# Copy to .env and fill in your values.
# ============================================================

# Bluesky account credentials
# Create an App Password at: https://bsky.app/settings/app-passwords
BSKY_HANDLE=vovalo.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Supabase (same values as in app/.env.local)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL (used in bot reply messages)
APP_URL=https://trendarena.app

# Prediction settings
PREDICTION_RESOLVE_MINUTES=60   # How long until a prediction is evaluated

# Virality thresholds
# A post is "viral" if it grows by VIRAL_GROWTH_RATE (e.g. 0.5 = 50%)
# AND has at least VIRAL_MIN_LIKES total likes.
VIRAL_GROWTH_RATE=0.5
VIRAL_MIN_LIKES=10

# Points awarded per outcome
BOT_POINTS_CORRECT=100
BOT_POINTS_INCORRECT=0
